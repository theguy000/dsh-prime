{
  "name": "dsh-prime",
  "version": "1.2.0",
  "type": "module",
  "main": "./index.js",
  "description": "Prime mode for DeepSeek Harness: a prime-agent-style self-improving agent preset plus the scoped Continual Harness (/refine) it is built around.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prime-agent",
    "rlm",
    "continual-harness"
  ],
  "engines": {
    "dsh": ">=0.1.5 <0.3.0",
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "tool.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./tool": "./tool.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node test/self-check.mjs && node test/validate-patch.mjs && node test/scope-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
